# ============================================================================
#  工具链文件(toolchain file)—— 告诉 CMake"用什么编译器、为目标平台编译"
# ----------------------------------------------------------------------------
#  用法(必须在配置阶段指定,事后改要删掉 build 目录重来):
#    cmake -DCMAKE_TOOLCHAIN_FILE=cmake/arm-none-eabi-cortex-m4.cmake ..
#
#  工具链文件的特殊之处:它在 project() 之前就被 CMake 读取,
#  所以这里的变量能影响"编译器探测"这个最早期阶段——
#  这也是为什么编译器路径必须写在这里,写在普通 CMakeLists 里就晚了。
# ============================================================================

# ----------------------------------------------------------------------------
# 目标系统描述
#   Generic = "没有操作系统"的裸机平台。
#   如果照抄普通工程写 Linux,CMake 会假设目标有内核,
#   探测编译器时去检查能否链接出可执行文件——裸机根本没有 OS,
#   检查必然失败,配置直接报错。
#   SYSTEM_PROCESSOR 写 arm,供工程脚本里做平台判断用。
# ----------------------------------------------------------------------------
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

# ----------------------------------------------------------------------------
# 编译器路径(不带完整路径时 CMake 按 PATH 环境变量查找)
#   arm-none-eabi = "ARM 架构 / 无厂商 / 无 OS(eabi)"的工具链,
#   和 S32DS 内置的是同一族 GCC。
#   ASM 编译器也填 gcc:大写 .S 的汇编文件要先过 C 预处理器
#   (处理 #include/#define),由 gcc 驱动统一调度最省心。
# ----------------------------------------------------------------------------
set(TOOLCHAIN_PREFIX arm-none-eabi)
set(CMAKE_C_COMPILER   ${TOOLCHAIN_PREFIX}-gcc)
set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PREFIX}-g++)
set(CMAKE_ASM_COMPILER ${TOOLCHAIN_PREFIX}-gcc)

# ----------------------------------------------------------------------------
# 后处理工具:objcopy(格式转换)和 size(体积统计)
#   find_program:在 PATH 里找,结果存入变量;找不到则为空,
#   顶层用 ${CMAKE_OBJCOPY} 时就是空命令,不至于直接报错。
#   变量名用 CMAKE_OBJCOPY/CMAKE_SIZE 是 CMake 的约定:
#   启用对应语言时它自己也会来填这组变量。
#   CACHE FILEPATH "":提升为缓存变量,cmake-gui 里可见可改。
# ----------------------------------------------------------------------------
find_program(CMAKE_OBJCOPY ${TOOLCHAIN_PREFIX}-objcopy)
find_program(CMAKE_SIZE    ${TOOLCHAIN_PREFIX}-size)

# ----------------------------------------------------------------------------
# 编译器探测行为修正(裸机工程的标配三行之一,另两个是 SYSTEM_NAME 和编译器)
#   CMake 配置时会先编译一个小测试程序验证工具链可用。
#   默认它要"编译+链接"出可执行文件;但裸机工程:
#     - 没有指定链接脚本前链接会失败
#     - 有的甚至没有标准 main 入口
#   改成 STATIC_LIBRARY 后,探测只做"编译成静态库",
#   绕开链接环节,配置才能顺利通过。
# ----------------------------------------------------------------------------
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
